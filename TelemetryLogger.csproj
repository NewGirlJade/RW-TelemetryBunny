    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>../../../../BepInEx/core/MonoMod.Utils.dll</HintPath>
    </Reference>
    
    <!-- BepInEx Utils -->
    <Reference Include="PUBLIC-Assembly-CSharp">
      <HintPath>../../../../BepInEx/utils/PUBLIC-Assembly-CSharp.dll</HintPath>
    </Reference>

    <!-- BepInEx Plugins -->
    <Reference Include="HOOKS-Assembly-CSharp">
      <HintPath>../../../../BepInEx/plugins/HOOKS-Assembly-CSharp.dll</HintPath>
    </Reference>

    <!-- Rain World Managed DLLs -->
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>../../../../RainWorld_Data/Managed/Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>../../../../RainWorld_Data/Managed/Unity.Mathematics.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
