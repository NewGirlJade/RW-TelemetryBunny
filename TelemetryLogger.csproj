    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>../../../../RainWorld_Data/Managed/UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
