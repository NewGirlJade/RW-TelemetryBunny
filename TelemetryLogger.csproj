    </Reference>
    
    <Reference Include="Newtonsoft.Json">
      <HintPath>Newtonsoft.Json.dll</HintPath>
    </Reference>
    
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy
            SourceFiles="$(OutputPath)$(AssemblyName).dll"
            DestinationFolder="$(ProjectDir)plugins\"
    />
  </Target>
  
</Project>
